# Copy this file to .env and edit as needed. All values are optional.

# Hugging Face model to load, and the revision (branch, tag, or commit hash).
BIRD_MODEL_NAME=ozzyonfire/bird-species-classifier
BIRD_MODEL_REVISION=d4d80527be1343dacfe67af84d064ca6f9b7547e

# Largest photo accepted, in megabytes.
BIRD_MAX_UPLOAD_MB=10

# Results with a top confidence below this (0 to 1) are flagged as "not sure".
BIRD_LOW_CONFIDENCE_THRESHOLD=0.5

# Largest image accepted, in total pixels (width x height). Guards against
# decompression-bomb images.
BIRD_MAX_IMAGE_PIXELS=64000000

# Address and port used by `python -m app.main`. 127.0.0.1 keeps the app
# reachable only from this computer.
BIRD_HOST=127.0.0.1
BIRD_PORT=8000

# Comma-separated host names the server answers to. Add your computer's IP
# address here if you change BIRD_HOST to make the app reachable on your network.
BIRD_ALLOWED_HOSTS=127.0.0.1,localhost

# Logging level: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
BIRD_LOG_LEVEL=INFO
